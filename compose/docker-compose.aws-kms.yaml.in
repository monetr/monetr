# vim: set ft=yaml
services:
  kms:
    image: nsmithuk/local-kms
    restart: always # If something goes wrong just restart the container, this is for development only.
    volumes:
      - "@AWS_KMS_SEED_FILE@:/init/seed.yaml"
  monetr:
    links:
      - kms
    depends_on:
      kms:
        condition: service_started
