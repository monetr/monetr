global
    log stdout format raw local0

# Docker's embedded DNS server, this lets haproxy pick up containers that start
# late or come back with a new IP after a restart.
resolvers docker
    nameserver dns 127.0.0.11:53
    hold valid 10s

crt-store local
    crt-base /usr/local/etc/haproxy/tls
    key-base /usr/local/etc/haproxy/tls
    load crt "cert.pem" key "key.pem"

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    timeout client 600s
    timeout server 30s
    # Websockets (vite HMR, mailpit) stay open for a long time.
    timeout tunnel 1h
    default-server init-addr last,libc,none resolvers docker

frontend https
    bind :443 ssl crt "@local/cert.pem"

    unique-id-format %[uuid()]

    http-request set-header X-Real-IP %[src]
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto https

    acl host_my req.hdr(host),field(1,:),lower -m str my.@MONETR_LOCAL_DOMAIN@
    use_backend monetr if host_my { path_beg /api }
    use_backend ui if host_my
    # Every other subdomain is routed to the backend with the same name, so
    # s3.@MONETR_LOCAL_DOMAIN@ goes to the s3 backend. If that backend does not
    # exist then this rule is skipped and the request gets a 503.
    use_backend %[req.hdr(host),lower,field(1,.)]

backend monetr
    http-request set-header X-Request-Id %[unique-id]
    http-request deny deny_status 413 if { req.hdr_val(content-length) gt 5242880 }
    server monetr monetr:4000

backend ui
    timeout server 600s
    # If security headers like X-Frame-Options are added here then react's
    # profiler wont support reload and profile.
    server ui ui:3000

@S3_HAPROXY_CONFIG@

@OPENBAO_HAPROXY_CONFIG@

@VAULT_HAPROXY_CONFIG@

@NGROK_HAPROXY_CONFIG@

@MAIL_HAPROXY_CONFIG@
