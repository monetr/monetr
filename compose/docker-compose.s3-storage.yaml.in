# vim: set ft=yaml
services:
  s3:
    image: rustfs/rustfs:1.0.0
    restart: always # If something goes wrong just restart the container, this is for development only.
    volumes:
      - s3Data:/data
    ports:
      - 9001:9001
    healthcheck:
      test: curl -sf http://127.0.0.1:9000/health || exit 1
      interval: 3s
      timeout: 15s
      retries: 10
      start_period: 5s
    environment:
      RUSTFS_ACCESS_KEY: monetr
      RUSTFS_SECRET_KEY: password
      RUSTFS_CONSOLE_ENABLE: "true"
      RUSTFS_CONSOLE_ADDRESS: 0.0.0.0:9001
    entrypoint: >
      /bin/sh -c "
      mkdir -p /data/monetr-storage;
      exec /entrypoint.sh rustfs;
      "
  monetr:
    links:
      - s3
    environment:
      # Storage settings
      AWS_ACCESS_KEY: monetr
      AWS_SECRET_KEY: password

volumes:
  s3Data:
